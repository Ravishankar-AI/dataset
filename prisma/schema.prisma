// Objectways Data catalog schema.
//
// One dataset registry, filtered by access tier at the query layer (see
// src/lib/catalog.ts) rather than split into separate databases.
//
// Postgres via Railway. DATABASE_URL points at the Railway Postgres
// service and is used both at runtime and for `prisma migrate` — no
// separate pooled/direct split needed since Railway doesn't put a
// transaction-mode pooler in front of it by default.
//
// Note: fields documented as enums are plain Strings — this schema also
// ran on SQLite during early scaffolding, which has no native enum type,
// and there's no need to diverge now that we're on Postgres. The allowed
// values are enforced in the application layer (src/lib/catalog.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  createdAt        DateTime          @default(now())
  users            User[]
  entitlements     Entitlement[]
  purchaseRequests PurchaseRequest[]
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  passwordHash   String
  // "contributor" | "customer" | "admin"
  role           String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
}

model Modality {
  id              String    @id @default(cuid())
  key             String    @unique
  name            String
  sensorManifest  String
  sensorNote      String?
  typicalUse      String
  datasets        Dataset[]
}

model Dataset {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String
  modality     Modality      @relation(fields: [modalityId], references: [id])
  modalityId   String
  // "sample" | "customer" — which door a published dataset appears behind.
  accessTier   String
  // "draft" | "published"
  status       String        @default("draft")
  version      String        @default("v1")
  sizeBytes    BigInt        @default(0)
  // LeRobot dataset layout under objectPrefix: data/{chunk}/episode_NNNNNN.parquet,
  // videos/{chunk}/{camera}/episode_NNNNNN.mp4 per entry in `cameras`.
  objectPrefix String
  chunk        String        @default("chunk-000")
  cameras      String[]      @default([])
  fps          Int           @default(30)
  // Physical rig and camera hardware -- dataset-level constants, not derived
  // from meta/info.json (which only records the internal robot_type key).
  robotType    String?
  cameraModel  String?
  // Free-form display string (e.g. "$8,500", "Contact for pricing") --
  // shown on /datasets for customer-tier datasets. No payment processor is
  // wired up yet: "Request Purchase" creates a PurchaseRequest for manual
  // follow-up, the same way Entitlement grants are handled today.
  priceLabel   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        Task[]
  episodes     Episode[]
  entitlements Entitlement[]
  purchaseRequests PurchaseRequest[]
}

// A LeRobot "task" (from meta/tasks.jsonl) -- a distinct instruction a
// dataset's episodes were captured performing. Most real datasets have
// exactly one; multi-task datasets group deliverables by which
// instruction they demonstrate.
model Task {
  id         String    @id @default(cuid())
  dataset    Dataset   @relation(fields: [datasetId], references: [id])
  datasetId  String
  taskIndex  Int
  title      String
  // LeRobot dataset layout for this task's own capture folder -- required
  // for multi-task datasets where each task is a separate raw capture with
  // its own bucket prefix and camera set (see Dataset.objectPrefix docs).
  objectPrefix String
  chunk        String    @default("chunk-000")
  cameras      String[]  @default([])
  // Denormalized cameras.length -- lets the deliverable browser filter by
  // camera count with a plain Prisma where-clause instead of a raw query.
  cameraCount  Int       @default(0)
  episodes   Episode[]

  @@unique([datasetId, taskIndex])
}

model Episode {
  id              String    @id @default(cuid())
  dataset         Dataset   @relation(fields: [datasetId], references: [id])
  datasetId       String
  // Set for real LeRobot-backed episodes (used to derive parquet/video keys
  // via src/lib/lerobot.ts); null for the synthetic ingestion-queue demo
  // episodes, which just use objectKey directly.
  task            Task?     @relation(fields: [taskId], references: [id])
  taskId          String?
  episodeIndex    Int?
  capturedAt      DateTime
  durationSeconds Int
  sizeBytes       BigInt
  objectKey       String
  // "queued" | "validating" | "cataloged" | "rejected"
  status          String    @default("queued")
  rejectionReason String?
  createdAt       DateTime  @default(now())
  // True once a first-frame JPEG exists at episodeThumbnailKey() (see
  // src/lib/lerobot.ts) -- generated out-of-band (ffmpeg needs a video
  // file, not something the app server does at request time) and flipped
  // on here once the upload is confirmed. False means render the
  // fallback camera icon instead of a broken <img>.
  hasThumbnail    Boolean   @default(false)

  @@unique([taskId, episodeIndex])
}

// Grants a customer organization access to a specific published dataset.
model Entitlement {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  dataset        Dataset      @relation(fields: [datasetId], references: [id])
  datasetId      String
  grantedAt      DateTime     @default(now())

  @@unique([organizationId, datasetId])
}

// Submitted from /datasets when a customer clicks "Request Purchase" on a
// dataset their org isn't entitled to yet. No payment processor is wired up
// -- staff review these and manually create the matching Entitlement, same
// as every entitlement granted so far.
model PurchaseRequest {
  id               String       @id @default(cuid())
  dataset          Dataset      @relation(fields: [datasetId], references: [id])
  datasetId        String
  organization     Organization @relation(fields: [organizationId], references: [id])
  organizationId   String
  requestedByName  String
  requestedByEmail String
  // "pending" | "approved" | "declined"
  status           String       @default("pending")
  createdAt        DateTime     @default(now())
}

// Submitted from /uploads -- someone wanting to sell their capture data to
// Objectways, or have an evaluation run against our platform. Not tied to
// an existing account/org since the submitter may not be a customer yet;
// staff follow up by email to arrange the actual file transfer.
model IntakeRequest {
  id               String   @id @default(cuid())
  // "sell_data" | "request_evaluation"
  kind             String
  contactName      String
  contactEmail     String
  organizationName String?
  description      String
  transferNotes    String?
  // "new" | "in_review" | "closed"
  status           String   @default("new")
  createdAt        DateTime @default(now())
}
