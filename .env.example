# --- Database (Supabase Postgres) ---
# From Supabase: Project → Connect → ORM → Prisma. DATABASE_URL is the
# pooled connection (used at runtime); DIRECT_URL is the direct connection
# (used only for `prisma migrate`).
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth (Supabase Auth) ---
# From Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Object storage (self-hosted MinIO, S3-compatible) ---
# MinIO running against the NAS's own disks — not a cloud provider, to
# avoid cloud storage/egress billing. Leave unset in local dev —
# lib/storage.ts falls back to placeholder download links when these are
# missing, so the UI still works without live credentials.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET_SAMPLES="samples"
OBJECT_STORAGE_BUCKET_DATASETS="datasets"
# Public base URL for sample clips — either a bucket alias exposed by
# your MinIO/reverse-proxy setup, or a CDN in front of it.
OBJECT_STORAGE_PUBLIC_URL=""
