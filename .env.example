# --- Database (Supabase Postgres) ---
# From Supabase: Project → Connect → ORM → Prisma. DATABASE_URL is the
# pooled connection (used at runtime); DIRECT_URL is the direct connection
# (used only for `prisma migrate`).
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth (Supabase Auth) ---
# From Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Cloudflare R2 (S3-compatible object storage) ---
# Leave unset in local dev — lib/r2.ts falls back to placeholder download
# links when these are missing, so the UI still works without live credentials.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_SAMPLES="samples"
R2_BUCKET_DATASETS="datasets"
R2_PUBLIC_SAMPLES_URL=""

# --- NAS (S3-compatible / MinIO capture staging, read-only listing) ---
# Leave unset in local dev — lib/nas.ts falls back to an empty, non-live
# result when these are missing, so /uploads still renders without live
# infrastructure. Only lists what's on the NAS; does not write to the
# catalog — that's the (separate) ingestion worker's job.
NAS_ENDPOINT="https://nas.objectways.com"
NAS_ACCESS_KEY_ID=""
NAS_SECRET_ACCESS_KEY=""
NAS_BUCKET="teleoperation"
# Set to "true" only if the NAS presents a self-signed/internal cert.
NAS_TLS_INSECURE="false"
