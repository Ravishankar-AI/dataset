# --- Database (Supabase Postgres) ---
# From Supabase: Project → Connect → ORM → Prisma. DATABASE_URL is the
# pooled connection (used at runtime); DIRECT_URL is the direct connection
# (used only for `prisma migrate`).
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth (Supabase Auth) ---
# From Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- MinIO (S3-compatible object storage, running as a QNAP NAS app) ---
# MinIO's storage backend is the NAS's own disk, and the NAS is reachable
# over the internet through the QNAP's reverse proxy (Let's Encrypt cert),
# so one bucket + one signed-URL pattern covers both public samples and
# licensed datasets. Leave unset in local dev — lib/minio.ts falls back to
# placeholder download links when these are missing, so the UI still works
# without live credentials.
MINIO_ENDPOINT="https://nas.objectways.com"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="teleoperation"
