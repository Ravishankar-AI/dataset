# --- Database ---
# Local dev defaults to SQLite (see prisma/schema.prisma). For production,
# point this at managed Postgres (Neon/Supabase) and switch the schema's
# datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Cloudflare R2 (S3-compatible object storage) ---
# Leave unset in local dev — lib/r2.ts falls back to placeholder download
# links when these are missing, so the UI still works without live credentials.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_SAMPLES="samples"
R2_BUCKET_DATASETS="datasets"
R2_PUBLIC_SAMPLES_URL=""

# --- Auth (placeholder) ---
# lib/auth.ts implements a mock session so the three access tiers (Samples /
# Uploads / Datasets) can be exercised without a real IdP. Replace with
# Clerk or Supabase Auth env vars when that integration is wired in.
MOCK_AUTH_SECRET="dev-only-secret-change-me"
