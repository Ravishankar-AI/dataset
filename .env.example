# --- Database (Railway Postgres) ---
# From Railway: Postgres service → Connect. Use the public connection URL
# for local dev / running `prisma migrate` from outside Railway; the app's
# own Railway service should instead use the private network URL Railway
# injects when both services live in the same project.
DATABASE_URL="postgresql://postgres:PASSWORD@containers-usXX.railway.app:PORT/railway"

# --- MinIO (self-hosted, S3-compatible, running as a QNAP NAS app) ---
# MinIO's storage backend is the NAS's own disk, and the NAS is reachable
# over the internet through the QNAP's reverse proxy. Everything lives in
# one bucket — there's no separate public/CDN-fronted bucket, so public
# sample clips use a signed URL like everything else. Leave unset in local
# dev — lib/minio.ts falls back to placeholder download links (and an
# empty bucket listing on /uploads) when these are missing, so the UI
# still works without live credentials.
MINIO_ENDPOINT="https://nas.objectways.com"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="teleoperation"
# Set to "true" only as a stopgap if the QNAP reverse proxy's TLS chain is
# incomplete (confirmed via `openssl s_client -showcerts`) — fix that at
# the reverse proxy rather than relying on this long-term.
MINIO_TLS_INSECURE="false"
